RAG_VECTOR_BACKEND=qdrant
RAG_GRAPH_BACKEND=neo4j
RAG_CANONICAL_BACKEND=postgres
RAG_OBJECT_BACKEND=minio

RAG_ENABLE_EMBEDDINGS=true
RAG_ENABLE_RERANKER=true
RAG_ALLOW_MODEL_DOWNLOAD=false
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=64
RAG_OPENVINO_DEVICE=CPU
RAG_OPENVINO_EXPORT=false
RAG_RERANKER_DEVICE=cpu
OPENVINO_TELEMETRY_DISABLE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
RAG_ANSWER_MODEL=gemini-3.1-flash-lite

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_traffic_records
QDRANT_TIMEOUT=60

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalrag
NEO4J_DATABASE=neo4j

POSTGRES_DSN=postgresql://legalrag:legalrag@localhost:55432/legalrag

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legal-rag-assets
MINIO_SECURE=false
