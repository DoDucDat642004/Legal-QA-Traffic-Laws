# Full-stack local RAG profile.
# Copy to .env only when running docker-compose.rag.yml services.

GEMINI_API_KEY=
GENAI_API_KEY=

RAG_VECTOR_BACKEND=qdrant
RAG_GRAPH_BACKEND=neo4j
RAG_CANONICAL_BACKEND=postgres
RAG_OBJECT_BACKEND=minio

RAG_ENABLE_EMBEDDINGS=true
RAG_ENABLE_RERANKER=false
RAG_ENABLE_RERANKER_FOR_HARD=true
RAG_ALLOW_MODEL_DOWNLOAD=false
RAG_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RAG_EMBEDDING_BACKEND=openvino
RAG_EMBEDDING_DIMENSION=768
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_LENGTH=256

RAG_OPENVINO_DEVICE=CPU
RAG_OPENVINO_MODEL_DIR=data/models/openvino/bkai-foundation-models_vietnamese-bi-encoder
RAG_OPENVINO_EXPORT=false
RAG_ENABLE_RERANKER=false
RAG_ENABLE_RERANKER_FOR_HARD=true
RAG_RERANKER_BACKEND=openvino
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_DEVICE=CPU
RAG_RERANKER_MAX_LENGTH=256
RAG_ALLOW_RERANKER_DOWNLOAD=false
RAG_OPENVINO_RERANKER_MODEL_DIR=data/models/openvino/BAAI_bge-reranker-v2-m3
RAG_MODEL_RERANK_LIMIT=8
RAG_RERANK_MIN_DIFFICULTY_SCORE=5

RAG_ENABLE_AI_PLANNER=true
RAG_AI_PLANNER_ALWAYS=false
RAG_AI_PLANNER_MIN_RULE_CONFIDENCE=0.72
RAG_AI_PLANNER_MAX_QUERIES=8
RAG_MAX_PLANNED_QUERIES=8
RAG_VECTOR_SEARCH_MULTIPLIER=2
RAG_STRICT_VECTOR_BACKEND=true
RAG_STRICT_GRAPH_BACKEND=false
RAG_PROFILE=balanced

RAG_ANSWER_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_VISION_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_PLANNER_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_CONDENSE_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_SIGN_PROBE_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_PROMPT_CONTEXT_TEXT_LIMIT=16000
RAG_PROMPT_STRUCTURED_TEXT_LIMIT=45000
RAG_ANSWER_MAX_OUTPUT_TOKENS=8192
RAG_ANSWER_MAX_CONTINUATIONS=1
RAG_MAX_PROMPT_IMAGES=2
RAG_EXTRACTIVE_MAX_CONTEXTS=18
RAG_EXTRACTIVE_TEXT_LIMIT=420
RAG_EXTRACTIVE_TABLE_ROWS=10
RAG_INCLUDE_ANSWER_TRACE=true
RAG_AUTO_VERIFY_CLAIMS=true
RAG_AUTO_VERIFY_MAX_CLAIMS=18
RAG_CHAT_TEXT_DEADLINE_SECONDS=300
RAG_TIMEOUT_FALLBACK_TOP_K=16
RAG_TIMEOUT_FALLBACK_EXPAND_DEPTH=1
RAG_TIMEOUT_FALLBACK_CONTEXTS=12

OPENVINO_TELEMETRY_DISABLE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_traffic_records_vi
QDRANT_TIMEOUT=300
QDRANT_EMBED_TEXT_MAX_CHARS=1800
QDRANT_UPSERT_BATCH_SIZE=32
RAG_QDRANT_VECTOR_MULTIPLIER=4
RAG_QDRANT_ENABLE_LEXICAL=true

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalrag
NEO4J_DATABASE=neo4j

POSTGRES_DSN=postgresql://legalrag:legalrag@localhost:55432/legalrag
POSTGRES_SYNC_COMMIT_BATCH_SIZE=500

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legal-rag-assets
MINIO_SECURE=false
