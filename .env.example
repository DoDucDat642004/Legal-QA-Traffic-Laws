# Copy this file to .env for local development.
# Never commit .env or real credentials.

# Google GenAI. Required for LLM synthesis and image sign recognition.
GEMINI_API_KEY=
GENAI_API_KEY=

# Frontend -> API URL. In Docker/Spaces this is set by entrypoint.sh.
TRAFFIC_LAW_API_URL=http://localhost:8002

# Default RAG runtime: Qdrant vector store with OpenVINO vietnamese-bi-encoder.
RAG_VECTOR_BACKEND=qdrant
RAG_GRAPH_BACKEND=local
RAG_CANONICAL_BACKEND=local
RAG_OBJECT_BACKEND=local

# Embeddings use the checked-in/exported OpenVINO model by default.
RAG_ENABLE_EMBEDDINGS=true
RAG_ALLOW_MODEL_DOWNLOAD=false
RAG_ENABLE_RERANKER=true
RAG_RERANKER_BACKEND=openvino
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKER_DEVICE=cpu
RAG_ALLOW_RERANKER_DOWNLOAD=false
RAG_OPENVINO_RERANKER_MODEL_DIR=data/models/openvino/cross-encoder_mmarco-mMiniLMv2-L12-H384-v1
RAG_MODEL_RERANK_LIMIT=32
RAG_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
RAG_EMBEDDING_BACKEND=openvino
RAG_EMBEDDING_DIMENSION=768
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_LENGTH=256
RAG_OPENVINO_DEVICE=CPU
RAG_OPENVINO_MODEL_DIR=data/models/openvino/bkai-foundation-models_vietnamese-bi-encoder
RAG_OPENVINO_EXPORT=false

# Model routing. Values not in src/rag/model_policy.py are ignored.
RAG_ANSWER_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_VISION_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_PLANNER_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_SIGN_PROBE_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Query planning and retrieval budgets.
RAG_ENABLE_AI_PLANNER=true
RAG_AI_PLANNER_ALWAYS=false
RAG_AI_PLANNER_MIN_RULE_CONFIDENCE=0.72
RAG_AI_PLANNER_MAX_QUERIES=2
RAG_MAX_PLANNED_QUERIES=3
RAG_RETRIEVAL_MAX_ROUNDS=3
RAG_RETRIEVAL_MAX_SLOTS=18
RAG_ANSWER_REPAIR_ROUNDS=1
RAG_VECTOR_SEARCH_MULTIPLIER=2
RAG_GRAPH_MAX_EXPANDED_NODES=320
RAG_STRICT_VECTOR_BACKEND=true
RAG_STRICT_GRAPH_BACKEND=false

# Answer generation limits.
RAG_PROMPT_CONTEXT_TEXT_LIMIT=50000
RAG_PROMPT_STRUCTURED_TEXT_LIMIT=120000
RAG_ANSWER_MAX_OUTPUT_TOKENS=32768
RAG_ANSWER_MAX_CONTINUATIONS=2
RAG_MAX_PROMPT_IMAGES=8
RAG_EXTRACTIVE_MAX_CONTEXTS=80
RAG_EXTRACTIVE_TEXT_LIMIT=12000

# Local index/filter behavior.
RAG_STRICT_FILTERS=true
RAG_DISABLE_EXPANDED_RECORDS_CACHE=false
RAG_EXPANDED_RECORDS_CACHE_DIR=data/vector_db/expanded_records_cache

# Offline and CPU-friendly defaults.
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENVINO_TELEMETRY_DISABLE=1

# Optional Qdrant backend.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_traffic_records_vi
QDRANT_TIMEOUT=300
QDRANT_EMBED_TEXT_MAX_CHARS=1800
QDRANT_UPSERT_BATCH_SIZE=32
RAG_QDRANT_VECTOR_MULTIPLIER=4
RAG_QDRANT_ENABLE_LEXICAL=true

# Optional Neo4j backend.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalrag
NEO4J_DATABASE=neo4j

# Optional PostgreSQL and MinIO sync backends.
POSTGRES_DSN=postgresql://legalrag:legalrag@localhost:55432/legalrag
POSTGRES_SYNC_COMMIT_BATCH_SIZE=500
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=legal-rag-assets
MINIO_SECURE=false

# Optional extraction/evaluation pipeline settings.
LLAMA_CLOUD_API_KEY=
PDF_ENGINE=auto
RETRY_SOURCE_FALLBACK_CHUNKS=false
DOTENV_OVERRIDE=0
RAG_PROFILE=balanced
QA_RELAXED_QUOTE_VALIDATION=false
QA_ENABLE_FUZZY_QUOTE_VALIDATION=true
QA_FUZZY_QUOTE_MIN_RATIO=0.94
QA_LOG_INVALID_QUOTES=false
QA_MIN_PAIRS_PER_CHUNK=2
QA_PROMPT_MODE=few_shot_cot
